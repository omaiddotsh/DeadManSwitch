# Copy to .env.local for `npm run dev`; on Railway set these as service variables.

# ─── Public: inlined into the browser bundle at BUILD time ──────────────────
# DeadManSwitch deployments: the current one per chain (new switches are
# created there). Overrides lib/deployments.json `contracts`. A chain with no
# deployment, current or previous, is hidden from wallets.
NEXT_PUBLIC_CONTRACT_1=
NEXT_PUBLIC_CONTRACT_11155111=
# Deploy blocks of the current deployments: SwitchCreated scans start here
# (0 = genesis = thousands of getLogs).
NEXT_PUBLIC_FROM_BLOCK_1=
NEXT_PUBLIC_FROM_BLOCK_11155111=
# Previous deployments, after a redeploy on the same chain: comma-separated
# <address>:<deploy block>. Their switches stay listed and usable (ping,
# cancel, top-up, release, reclaim); only creates go to the current one. Never
# drop an old address while it holds a switch that is not revealed or cancelled.
# lib/deployments.json `previousContracts` adds compiled-in entries.
NEXT_PUBLIC_PREVIOUS_CONTRACTS_1=
NEXT_PUBLIC_PREVIOUS_CONTRACTS_11155111=
# JSON-RPC for reads, log scans and the FHE SDK's host-chain calls. Required
# (`next build` fails without it) on every chain with a deployment: the public
# defaults cap eth_getLogs spans (sepolia.drpc.org's free plan: 101 blocks) or
# prune old logs, and switch discovery then takes minutes. The provider must
# accept NEXT_PUBLIC_LOGS_RANGE_CAP blocks per eth_getLogs back to the deploy
# block. ALLOW_PUBLIC_RPC=1 builds with the default anyway (throwaway builds).
NEXT_PUBLIC_RPC_URL_1=
NEXT_PUBLIC_RPC_URL_11155111=
# Max blocks per eth_getLogs call on mainnet/Sepolia (default 5000). Set it at or
# below your provider's span limit.
NEXT_PUBLIC_LOGS_RANGE_CAP=
# WalletConnect / Reown project id (RainbowKit).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Local Anvil + forge-fhevm host stack (dev only; never enable in production).
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=0
NEXT_PUBLIC_CONTRACT_31337=
NEXT_PUBLIC_RPC_URL_31337=http://127.0.0.1:8545
NEXT_PUBLIC_FROM_BLOCK_31337=0

# ─── Server-only: read at RUNTIME by app/api/relayer (never NEXT_PUBLIC_) ───
# Zama relayer API key (mainnet), injected by the /api/relayer proxy. Required
# on mainnet: without it the proxy refuses chain 1 (relayer_not_configured: 503
# on keyurl, 403 on the SDK's paths). It is sent to the mainnet relayer only:
# Zama's Sepolia relayer is open and this proxy forwards Sepolia requests
# without x-api-key unless ZAMA_RELAYER_API_KEY_11155111 is set.
ZAMA_RELAYER_API_KEY=
# Optional per-chain keys: when set and non-empty, they take precedence for that
# chain (an empty ZAMA_RELAYER_API_KEY_1 falls back to ZAMA_RELAYER_API_KEY).
# ZAMA_RELAYER_API_KEY_1=
# ZAMA_RELAYER_API_KEY_11155111=
# How many trusted proxies append to X-Forwarded-For in front of this server;
# the proxy's per-IP rate limit reads that entry. Default 1 (Railway's edge or
# one reverse proxy). 0 ignores the header.
# TRUSTED_PROXY_HOPS=1
# Optional relayer URL overrides (https only). Defaults shown.
# ZAMA_RELAYER_URL_1=https://relayer.mainnet.zama.org
# ZAMA_RELAYER_URL_11155111=https://relayer.testnet.zama.org
