# DeadManSwitch client (CLI + watcher). Copy to .env and fill in.

# Signer for transactions (create, ping, cancel, mark-dark, reveal, publish, watcher).
# Not needed for read-only commands (info, read, status): leave it empty there.
PRIVATE_KEY=

# JSON-RPC endpoint of the host chain. Must serve CHAIN_ID (checked on every run).
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 1 = Ethereum mainnet, 11155111 = Sepolia, 31337 = local Anvil + forge-fhevm.
# Nothing else: the contract only deploys where Zama's fhEVM host exists.
CHAIN_ID=11155111

# The deployed DeadManSwitch.
DMS_ADDRESS=0x

# Zama relayer API key (sent as the x-api-key header). Required on mainnet for
# `create` (encrypting the data key) and for `reveal` / the watcher (public
# decryption). Optional on Sepolia (Zama's Sepolia relayer is open). Not used on 31337.
ZAMA_RELAYER_API_KEY=

# Optional relayer override (default: the SDK preset —
# https://relayer.mainnet.zama.org or https://relayer.testnet.zama.org).
ZAMA_RELAYER_URL=

# Watcher: first block to scan for SwitchCreated (the contract's deploy block).
FROM_BLOCK=0
